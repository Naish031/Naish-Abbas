<section class="hero-section">
  {% comment %} mobile view {% endcomment %}
  <div class="mobile-text-container">
    {% if section.settings.hero_heading != blank %}
      <h1>{{ section.settings.hero_heading }}</h1>
    {% else %}
      <h1>The Gift Guide</h1>
    {% endif %}
    {% if section.settings.description != blank %}
      <p>{{ section.settings.description }}</p>
    {% else %}
      <p>Discover Joy: Your Ultimate Holiday Gift Destination.</p>
    {% endif %}
  </div>

  {% comment %} image container {% endcomment %}
  <div class="mobile-hero-container">
    <div class="image-container">
      <img
        src="{{ 'mobile-hero-frame.png' | asset_url }}"
        alt="Hero Image"
        width="100%"
        height="auto">
    </div>

    <div class="button-container">
      {% if section.settings.button_text != blank %}
        <a class="btn" href="{{ section.settings.button_link | default: '#' }}">
          <span>
            {{ section.settings.button_text }}
          </span>

          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="13"
            viewBox="0 0 26 13"
            stroke-width="1.5"
            fill="#F5F5F5">
            <path d="M0.999512 5.75L0.249512 5.75L0.249512 7.25L0.999512 7.25L0.999512 5.75ZM25.5298 7.03033C25.8227 6.73744 25.8227 6.26257 25.5298 5.96967L20.7569 1.1967C20.464 0.903807 19.9891 0.903807 19.6962 1.1967C19.4033 1.48959 19.4033 1.96447 19.6962 2.25736L23.9389 6.5L19.6962 10.7426C19.4033 11.0355 19.4033 11.5104 19.6962 11.8033C19.9891 12.0962 20.464 12.0962 20.7569 11.8033L25.5298 7.03033ZM0.999512 7.25L24.9995 7.25L24.9995 5.75L0.999512 5.75L0.999512 7.25Z" fill="#F5F5F5" />
          </svg>
        </a>

      {% else %}
        <a class="btn" href="#">
          <span>
            Shop Now
          </span>
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="13"
            viewBox="0 0 26 13"
            stroke-width="1.5"
            fill="#F5F5F5">
            <path d="M0.999512 5.75L0.249512 5.75L0.249512 7.25L0.999512 7.25L0.999512 5.75ZM25.5298 7.03033C25.8227 6.73744 25.8227 6.26257 25.5298 5.96967L20.7569 1.1967C20.464 0.903807 19.9891 0.903807 19.6962 1.1967C19.4033 1.48959 19.4033 1.96447 19.6962 2.25736L23.9389 6.5L19.6962 10.7426C19.4033 11.0355 19.4033 11.5104 19.6962 11.8033C19.9891 12.0962 20.464 12.0962 20.7569 11.8033L25.5298 7.03033ZM0.999512 7.25L24.9995 7.25L24.9995 5.75L0.999512 5.75L0.999512 7.25Z" fill="#F5F5F5" />
          </svg>
        </a>
      {% endif %}
    </div>
  </div>

  <div class="desktop-wrapper">
    <div class="desktop-content-container">
      <img
        src="{{ 'desktop-hero-frame.png' | asset_url }}"
        alt="Gift guide illustration"
        width="100%"
        height="auto"
        loading="eager">
    </div>
    <div class="desktop-content-wrapper">
      <div class="desktop-header-container">
        {% if section.settings.hero_heading != blank %}
          <h1>{{ section.settings.hero_heading }}</h1>
        {% else %}
          <h1>The Gift Guide</h1>
        {% endif %}
        {% if section.settings.description != blank %}
          <p>{{ section.settings.description }}</p>
        {% else %}
          <p>
            Discover Joy: Your Ultimate Holiday Gift Destination. Explore our curated selection and find the perfect gifts
          to delight your loved ones this holiday season.
          </p>
        {% endif %}

        <div class="desktop-button-container">
          {% if section.settings.button_text != blank %}
            <a href="{{ section.settings.button_link | default: '#' }}" class="btn">
              <span>
                {{ section.settings.button_text }}
              </span>
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="24"
                height="13"
                viewBox="0 0 26 13"
                stroke-width="1.5"
                fill="#F5F5F5">
                <path d="M0.999512 5.75L0.249512 5.75L0.249512 7.25L0.999512 7.25L0.999512 5.75ZM25.5298 7.03033C25.8227 6.73744 25.8227 6.26257 25.5298 5.96967L20.7569 1.1967C20.464 0.903807 19.9891 0.903807 19.6962 1.1967C19.4033 1.48959 19.4033 1.96447 19.6962 2.25736L23.9389 6.5L19.6962 10.7426C19.4033 11.0355 19.4033 11.5104 19.6962 11.8033C19.9891 12.0962 20.464 12.0962 20.7569 11.8033L25.5298 7.03033ZM0.999512 7.25L24.9995 7.25L24.9995 5.75L0.999512 5.75L0.999512 7.25Z" fill="#F5F5F5" />
              </svg>
            </a>
          {% else %}
            <a href="#" class="btn">
              <span>
                SHOP NOW
              </span>
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="24"
                height="13"
                viewBox="0 0 26 13"
                stroke-width="1.5"
                fill="#F5F5F5">
                <path d="M0.999512 5.75L0.249512 5.75L0.249512 7.25L0.999512 7.25L0.999512 5.75ZM25.5298 7.03033C25.8227 6.73744 25.8227 6.26257 25.5298 5.96967L20.7569 1.1967C20.464 0.903807 19.9891 0.903807 19.6962 1.1967C19.4033 1.48959 19.4033 1.96447 19.6962 2.25736L23.9389 6.5L19.6962 10.7426C19.4033 11.0355 19.4033 11.5104 19.6962 11.8033C19.9891 12.0962 20.464 12.0962 20.7569 11.8033L25.5298 7.03033ZM0.999512 7.25L24.9995 7.25L24.9995 5.75L0.999512 5.75L0.999512 7.25Z" fill="#F5F5F5" />
              </svg>
            </a>
          {% endif %}
        </div>
      </div>
    </div>
  </div>

  {% comment %} desktop version {% endcomment %}
  <div class="footer-text">
    {% if section.settings.footer_text != blank %}
      <p>{{ section.settings.footer_text }}</p>
    {% else %}
      <p>SUSTAINABLE, ETHICALLY MADE ACTIVEWEAR</p>
    {% endif %}
  </div>
</section>

<style>
  * {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  .hero-section {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    max-width: 3088px;
    margin: 0 auto;
  }

  .mobile-text-container {
    display: flex;
    flex-direction: column;
    gap: 24px;
    margin-top: 49px;
    padding: 0 16px;
    margin-bottom: 12px;
  }

  .mobile-text-container h1 {
    font-family: Jost;
    font-weight: 500;
    font-size: 30px;
    text-align: center;
  }

  .mobile-text-container p {
    font-family: Jost;
    font-weight: 400;
    font-size: 16px;
    line-height: 130%;
  }

  .mobile-hero-container {
    position: relative;
    width: 100%;
    height: 264px;
    overflow: hidden;
  }

  .image-container {
    width: 100%;
    height: 100%;
    overflow: hidden;
  }

  .button-container {
    position: absolute;
    bottom: 12%;
    left: 50%;
    transform: translateX(-50%);
    z-index: 10;
    background-color: #000;
    padding: 10px 20px;
    max-width: 193px;
    width: 100%;
  }

  .button-container .btn {
    display: inline-flex;
    gap: 10px;
    align-items: center;
    justify-content: space-between;
    text-decoration: none;
  }

  .button-container .btn span {
    display: flex;
    width: 119px;
    height: 19px;
    flex-direction: column;
    justify-content: center;
    font-family: Jost;
    font-weight: 400;
    font-size: 16px;
    line-height: 19px;
    text-align: center;
    color: #f5f5f5;
    text-transform: uppercase;
    text-decoration: none;
  }

  .button-container .btn svg {
    fill: #f5f5f5;
    width: clamp(24px, 1.5vw, 60px);
    height: auto;
  }

  .footer-text {
    width: 100%;
    padding: 17px 32px;
    background-color: #f5f5f5;
  }

  .footer-text p {
    font-family: Jost;
    font-weight: 400;
    font-size: 14px;
    line-height: 13.42px;
    color: #000;
  }

  .desktop-wrapper {
    display: none;
  }

  @media screen and (min-width: 768px) {
    .desktop-wrapper {
      display: block;
      position: relative;
      width: 100%;
    }

    .desktop-content-wrapper {
      position: relative;
      max-width: 3088px;
      margin: 0 auto;
      height: 100%;
    }


    .mobile-text-container,
    .mobile-hero-container {
      display: none;
    }

    .desktop-header-container {
      position: absolute;
      bottom: 20px;
      left: 0;
      padding-left: 16px;
      display: flex;
      flex-direction: column;
      gap: 20px;
      max-width: clamp(300px, 35vw, 1183px);
    }

    .desktop-header-container h1 {
      font-family: Jost;
      font-weight: 500;
      font-size: clamp(30px, 4vw, 165px);
      line-height: 100%;
      text-align: left;
    }

    .desktop-header-container p {
      font-family: Jost;
      font-weight: 400;
      font-size: clamp(14px, 1.4vw, 47px);
      line-height: 120%;
      text-align: left;
    }

    .desktop-button-container {
      display: flex;
      justify-content: space-between;
      align-items: center;
      background-color: #000;
      color: #fff;
      gap: 20px;
      padding: 11px 25px;
      position: relative;
      overflow: hidden;
      cursor: pointer;
      transition: color 0.3s ease
      , background-color 0.3s ease;
      width: clamp(180px, 13vw, 518px);
      height: clamp(40px, 3.5vw, 118px);
      outline: none;
      border: none;
    }

    /* sliding yellow overlay */
    .desktop-button-container::before {
      content: '';
      position: absolute;
      inset: 0;
      background-color: #fff544;
      transform: scaleX(0);
      transform-origin: left center;
      transition: transform 0.25s ease-in-out;
      z-index: 0;
      will-change: transform;
    }

    .desktop-button-container,
    .desktop-button-container * {
      position: relative;
      z-index: 1;
      color: inherit;
      text-decoration: none;
      text-transform: uppercase;
      transition: color 0.1s ease-in-out;
    }

    .desktop-button-container:hover,
    .desktop-button-container:focus {
      background-color: transparent;
      color: #000;
    }

    .desktop-button-container svg,
    .desktop-button-container svg path,
    .desktop-button-container svg * {
      fill: #fff !important;
      width: clamp(24px, 1.5vw, 60px);
      height: auto;
    }

    .desktop-button-container:hover svg,
    .desktop-button-container:hover svg path,
    .desktop-button-container:hover svg * {
      fill: #000 !important;
    }

    /* hover/focus transform moved to a hover-capable media query below */

    .desktop-button-container .btn {
      width: 100%;
      display: flex;
      justify-content: space-between;
      align-items: center;
      color: #fff !important;
      transition: color 0.15s ease;
      background: transparent;
    }

    .desktop-button-container .btn span {
      width: clamp(100px, 8vw, 205px);
      height: 19px;
      font-family: Jost;
      font-weight: 400;
      font-size: clamp(14px, 1.4vw, 37px);
      line-height: 19px;
      color: inherit;
      /* inherits white initially */
      text-transform: uppercase;
      text-decoration: none;
    }

    /* text becomes black when overlay slides in */
    .desktop-button-container:hover .btn,
    .desktop-button-container:focus .btn {
      color: #000 !important;
    }

    @media (prefers-reduced-motion: reduce) {
      .desktop-button-container::before,
      .desktop-button-container * {
        transition: none !important;
      }
      .desktop-button-container:hover::before,
      .desktop-button-container:focus::before {
        transform: scaleX(1);
      }
    }
  }

  /* Desktop-only hover (pointer: fine, supports hover) */
  @media (hover: hover) and (pointer: fine) {
    .desktop-button-container:hover::before,
    .desktop-button-container:focus::before {
      transform: scaleX(1);
    }
  }

  /* Touch & keyboard fallbacks: instant/snappier overlay */
  .desktop-button-container:active::before,
  .desktop-button-container:focus-within::before {
    transform: scaleX(1);
    transition-duration: 0.12s;
  }

  .desktop-button-container:focus-within {
    outline: 2px solid #000;
    outline-offset: 2px;
  }

  @media screen and (min-width: 1024px) {
    .desktop-header-container {
      bottom: 30px;
      gap: 30px;
    }

    .desktop-header-container p {
      line-height: 140%;
    }
  }

  @media screen and (min-width: 1280px) {
    .desktop-header-container {
      width: 100%;
      padding-left: 50px;
      gap: clamp(50px, 3.75vw, 120px);
      max-width: clamp(300px, 38vw, 1183px);
    }

    .desktop-header-container h1 {
      font-size: 70px;
      line-height: 140%;
    }

    .desktop-button-container {
      width: 220px;
      height: 50px;
    }

    .footer-text {
      padding-top: clamp(17px, 1.5vw, 26px);
      padding-bottom: clamp(17px, 1.5vw, 26px);
    }

    .footer-text p {
      font-size: clamp(14px, 1.2vw, 42px);
      line-height: 100%;
    }

    .product-grid-section {
      padding: 10px 50px;
    }
  }

  @media screen and (min-width: 1920px) {
    .desktop-header-container {
      max-width: clamp(300px, 38vw, 1183px);
    }

    .desktop-header-container h1 {
      font-size: clamp(30px, 5vw, 165px);
    }

    .desktop-button-container {
      width: clamp(180px, 13vw, 518px);
      height: clamp(40px, 3.5vw, 118px);
    }

    .desktop-button-container .btn span {
      width: clamp(100px, 11vw, 295px);
      font-size: clamp(14px, 1.4vw, 37px);
    }

  }

</style>

{% schema %}
  {
    "name": "Hero Section",
    "settings": [
      {
        "type": "header",
        "content": "Hero Section"
      },
      {
        "type": "text",
        "id": "hero_heading",
        "label": "Hero Heading",
        "default": "The Gift Guide"
      },
      {
        "type": "richtext",
        "id": "description",
        "label": "Description"
      },
      {
        "type": "url",
        "id": "button_link",
        "label": "Button Link"
      }, {
        "type": "text",
        "id": "button_text",
        "label": "Button Text",
        "default": "Shop Now"
      }, {
        "type": "text",
        "id": "footer_text",
        "label": "Footer Text"
      }
    ],
    "presets": [
      {
        "name": "Hero"
      }
    ]
  }
{% endschema %}