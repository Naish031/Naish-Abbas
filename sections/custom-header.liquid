<section
  class="custom-header"
  role="banner"
  aria-label="Custom Header">
  <div class="header-bar-content">
    <div class="hamburger-menu">
      <button
        class="hamburger-button"
        aria-label="Menu"
        aria-expanded="false"
        aria-controls="MobileNavMenu">

        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="20"
          height="13"
          viewBox="0 0 20 13"
          class="icon icon-hamburger"
          fill="currentColor">
          <path
            d="M1 6.5H19"
            stroke="black"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round" />
          <path
            d="M1 1.5H19"
            stroke="black"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round" />
          <path
            d="M1 11.5H19"
            stroke="black"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round" />
        </svg>
        {% comment %} <svg
                                                            xmlns="http://www.w3.org/2000/svg"
                                                            class="icon icon-hamburger"
                                                            width="18"
                                                            height="16"
                                                            viewBox="0 0 18 16"
                                                            role="img"
                                                            aria-hidden="true"
                                                          >
                                                            <path d="M1 .5a.5.5 0 1 0 0 1h15.71a.5.5 0 0 0 0-1zM.5 8a.5.5 0 0 1 .5-.5h15.71a.5.5 0 0 1 0 1H1A.5.5 0 0 1 .5 8m0 7a.5.5 0 0 1 .5-.5h15.71a.5.5 0 0 1 0 1H1a.5.5 0 0 1-.5-.5"
                                                            fill="currentColor"/>
                                                </svg> {% endcomment %}

        <svg
          xmlns="http://www.w3.org/2000/svg"
          fill="currentColor"
          class="icon icon-close"
          viewBox="0 0 18 16"
          width="18"
          height="16"
          role="img"
          aria-hidden="true">
          <path fill="currentColor" d="M.865 15.978a.5.5 0 0 0 .707.707l7.433-7.431 7.579 7.282a.501.501 0 0 0 .846-.37.5.5 0 0 0-.153-.351L9.712 8.546l7.417-7.416a.5.5 0 1 0-.707-.708L8.991 7.853 1.413.573a.5.5 0 1 0-.693.72l7.563 7.268z" />
        </svg>
      </button>
    </div>
    <div class="logo">
      {% if section.settings.logo_image != blank %}
        <img
          src="{{ section.settings.logo_image | asset_url }}"
          alt="Company Logo"
          width="150"
          height="44">
      {% else %}
        <span>TISSO VISON</span>
      {% endif %}
    </div>
    <div class="gift-message">
      {% if section.settings.gift_message != blank %}
        <p>{{ section.settings.gift_message }}</p>
      {% else %}
        <p>Find the ideal gift for your loved ones.</p>
      {% endif %}
    </div>
    <div class="gift-cta">
      {% if section.settings.gift_cta_text != blank %}
        <a href="{{ section.settings.gift_cta_link |  default: '#' }}" class="gift-button gift-link">
          {{- section.settings.gift_cta_text -}}
          <svg
            xmlns="http://www.w3.org/2000/svg"
            fill="none"
            class="icon icon-arrow"
            viewBox="0 0 14 10">
            <path
              fill="currentColor"
              fill-rule="evenodd"
              d="M8.537.808a.5.5 0 0 1 .817-.162l4 4a.5.5 0 0 1 0 .708l-4 4a.5.5 0 1 1-.708-.708L11.793 5.5H1a.5.5 0 0 1 0-1h10.793L8.646 1.354a.5.5 0 0 1-.109-.546"
              clip-rule="evenodd" />
          </svg>
        </a>
      {% else %}
        <a href="#" class="gift-button">
          choose gift
          <svg
            xmlns="http://www.w3.org/2000/svg"
            fill="none"
            class="icon icon-arrow"
            viewBox="0 0 14 10">
            <path
              fill="currentColor"
              fill-rule="evenodd"
              d="M8.537.808a.5.5 0 0 1 .817-.162l4 4a.5.5 0 0 1 0 .708l-4 4a.5.5 0 1 1-.708-.708L11.793 5.5H1a.5.5 0 0 1 0-1h10.793L8.646 1.354a.5.5 0 0 1-.109-.546"
              clip-rule="evenodd" />
          </svg>
        </a>
      {% endif %}
    </div>
  </div>

  <div class="mobile-nav-menu" id="MobileNavMenu">
    <p class="mobile-nav__text">{{ section.settings.gift_message }}</p>
    <div class="mobile-gift-cta">
      {% if section.settings.gift_cta_text != blank %}
        <a href="{{ section.settings.gift_cta_link |  default: '#' }}" class="mobile-gift-button">
          {{- section.settings.gift_cta_text -}}
          <svg
            xmlns="http://www.w3.org/2000/svg"
            fill="none"
            class="icon icon-arrow"
            viewBox="0 0 14 10">
            <path
              fill="currentColor"
              fill-rule="evenodd"
              d="M8.537.808a.5.5 0 0 1 .817-.162l4 4a.5.5 0 0 1 0 .708l-4 4a.5.5 0 1 1-.708-.708L11.793 5.5H1a.5.5 0 0 1 0-1h10.793L8.646 1.354a.5.5 0 0 1-.109-.546"
              clip-rule="evenodd" />
          </svg>
        </a>
      {% else %}
        <a href="#" class="mobile-gift-button">
          choose gift
          <svg
            xmlns="http://www.w3.org/2000/svg"
            fill="none"
            class="icon icon-arrow"
            viewBox="0 0 14 10">
            <path
              fill="currentColor"
              fill-rule="evenodd"
              d="M8.537.808a.5.5 0 0 1 .817-.162l4 4a.5.5 0 0 1 0 .708l-4 4a.5.5 0 1 1-.708-.708L11.793 5.5H1a.5.5 0 0 1 0-1h10.793L8.646 1.354a.5.5 0 0 1-.109-.546"
              clip-rule="evenodd" />
          </svg>
        </a>
      {% endif %}
    </div>
  </div>
</section>

<style>
  .custom-header {
    position: relative;
    background-color: #f7f7f7;
  }

  .header-bar-content {
    display: grid;
    width: 100%;
    grid-template-columns: auto 1fr auto;
    grid-template-areas: 'left center right';
    padding: 23px 16px;
    align-items: center;
    position: relative;
    z-index: 20;
    background-color: #f7f7f7;
  }

  .mobile-nav-menu {
    height: auto;
    max-height: 0;
    overflow: hidden;
    background-color: #f2f2f2;
    transition: max-height 0.3s ease-in-out
    , padding 0.3s ease-in-out;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 16px;
  }

  .mobile-nav__text {
    font-family: Jost;
    font-weight: 400;
    font-size: 16px;
    line-height: 13.42px;
    text-align: center;
  }

  .mobile-nav-menu.is-open {
    max-height: 130px;
    padding: 25px 16px;
  }

  .hamburger-button .icon-close {
    display: none;
  }

  /* swap icons when hamburger is toggled open (apply on all viewports) */
  .hamburger-button.is-open .icon-hamburger {
    display: none;
  }
  .hamburger-button.is-open .icon-close {
    display: inline-block;
  }

  .hamburger-menu {
    grid-area: left;
    justify-self: start;
    width: 24px;
    height: 24px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .hamburger-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    border: 0;
    background: transparent;
    cursor: pointer;
    color: #000;
  }

  .logo {
    grid-area: center;
    justify-self: center;
  }

  .logo img {
    object-fit: cover;
    object-position: center;
    width: 100%;
    height: 100%;
    max-height: 44px;
    max-width: 150px;
    display: block;
  }

  .logo span {
    font-family: 'Jost'
    , sans-serif;
    font-weight: 600;
    font-size: 20px;
    line-height: 25.6px;
    letter-spacing: 0;
    text-align: center;
    text-transform: uppercase;
    color: #000;
  }

  .gift-message {
    display: none;
    grid-area: center;
    justify-self: center;
  }

  .gift-message p {
    font-family: Jost;
    font-weight: 400;
    font-style: Regular;
    font-size: 16px;
    leading-trim: NONE;
    line-height: 13.42px;
    letter-spacing: 0;
    text-align: center;
    color: #000000;
    margin: 0;
  }

  .gift-cta {
    display: none;
  }

  .gift-cta .gift-button {
    align-items: center;
    justify-content: space-between;
    display: inline-flex;
    gap: 18px;
    border: 0;
    padding: 0;
    background: transparent;
    cursor: pointer;
    font-family: Jost;
    font-weight: 400;
    font-size: 16px;
    line-height: 20.48px;
    text-align: center;
  }

  .mobile-nav-menu .mobile-gift-cta {
    position: relative;
    display: none;
    grid-area: right;
    justify-self: end;
    background-color: #fff544;
    color: #000;
    padding: 11px 40px;
    overflow: hidden;
    cursor: pointer;
    transition: color 0.3s ease
    , background-color 0.3s ease;
  }

  /* show mobile CTA when the mobile nav menu is open */
  .mobile-nav-menu.is-open .mobile-gift-cta {
    display: inline-flex;
  }

  /* sliding black overlay for mobile CTA to match desktop */
  .mobile-nav-menu .mobile-gift-cta::before {
    content: '';
    position: absolute;
    inset: 0;
    background-color: #000;
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform 0.25s ease-in-out;
    z-index: 0;
    will-change: transform;
  }

  .mobile-gift-cta,
  .mobile-gift-cta * {
    position: relative;
    color: inherit;
    text-decoration: none;
    text-transform: uppercase;
    z-index: 1;
    transition: color 0.1s ease-in-out;
  }

  .mobile-gift-cta:hover,
  .mobile-gift-cta:focus {
    background-color: transparent;
    color: #fff;
  }

  .mobile-gift-cta .mobile-gift-button {
    color: inherit;
  }

  @media screen and (min-width: 768px) {
    .hamburger-menu {
      display: none;
    }

    .mobile-nav-menu {
      display: none;
    }

    .custom-header {
      padding: 10px 30px;
    }

    .logo {
      grid-area: left;
      justify-self: start;
    }

    .gift-message {
      display: block;
      text-align: center;
    }

    .gift-cta {
      position: relative;
      display: inline-flex;
      grid-area: right;
      justify-self: end;
      background-color: #fff544;
      color: #000;
      padding: 11px 40px;
      overflow: hidden;
      cursor: pointer;
      transition: color 0.3s ease
      , background-color 0.3s ease;
    }

    /* sliding black overlay */
    .gift-cta::before {
      content: '';
      position: absolute;
      inset: 0;
      background-color: #000;
      transform: scaleX(0);
      transform-origin: left center;
      transition: transform 0.25s ease-in-out;
      z-index: 0;
      will-change: transform;
    }

    .gift-cta,
    .gift-cta * {
      position: relative;
      color: inherit;
      text-decoration: none;
      text-transform: uppercase;
      z-index: 1;
      transition: color 0.1s ease-in-out;
    }

    .gift-cta:hover,
    .gift-cta:focus {
      background-color: transparent;
      color: #fff;
    }

    .gift-cta .gift-button {
      color: inherit;
    }

    /* show/hide hamburger and close icons when menu is toggled */
    .hamburger-button.is-open .icon-hamburger {
      display: none;
    }
    .hamburger-button.is-open .icon-close {
      display: inline-block;
    }

    /* hover/focus transform moved to a hover-capable media query below */
    .gift-cta:focus-visible {
      outline: 2px solid #000;
      outline-offset: 2px;
    }
  }

  /* Respect reduced motion preferences */
  @media (prefers-reduced-motion: reduce) {
    .gift-cta::before,
    .gift-cta * {
      transition: none !important;
    }
    .gift-cta:hover::before,
    .gift-cta:focus::before {
      transform: scaleX(1);
    }
  }

  /* Desktop-only hover (pointer: fine, supports hover) */
  @media (hover: hover) and (pointer: fine) {
    .gift-cta:hover::before,
    .gift-cta:focus::before {
      transform: scaleX(1);
    }
  }

  /* Touch & keyboard fallbacks: instant/snappier overlay */
  .gift-cta:active::before,
  .gift-cta:focus-within::before {
    transform: scaleX(1);
    transition-duration: 0.12s;
  }

  .gift-cta:focus-within {
    outline: 2px solid #000;
    outline-offset: 2px;
  }

  @media screen and (min-width: 1280px) {
    .header-bar-content {
      padding: 10px 50px;
    }
  }
</style>

{% schema %}
  {
    "name": "Custom Header",
    "settings": [
      {
        "type": "header",
        "content": "Custom Header"
      },
      {
        "type": "image_picker",
        "label": "Logo Image",
        "id": "logo_image"
      },
      {
        "type": "text",
        "id": "gift_message",
        "label": "Gift Message",
        "default": "Find the ideal gift for your loved ones."
      },
      {
        "type": "url",
        "id": "gift_cta_link",
        "label": "Gift CTA Link"
      }, {
        "type": "text",
        "id": "gift_cta_text",
        "label": "Gift CTA Text",
        "default": "choose gift"
      }
    ]
  }
{% endschema %}