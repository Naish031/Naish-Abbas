<section class="custom-header" role="banner" aria-label="Custom Header">
  <div class="hamburger-menu">
    <button class="hamburger-button" aria-label="Menu" aria-expanded="false" aria-controls="SiteNav">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        class="icon icon-hamburger"
        width="18"
        height="16"
        viewBox="0 0 18 16"
        role="img"
        aria-hidden="true"
      >
        <path d="M1 .5a.5.5 0 1 0 0 1h15.71a.5.5 0 0 0 0-1zM.5 8a.5.5 0 0 1 .5-.5h15.71a.5.5 0 0 1 0 1H1A.5.5 0 0 1 .5 8m0 7a.5.5 0 0 1 .5-.5h15.71a.5.5 0 0 1 0 1H1a.5.5 0 0 1-.5-.5"
        fill="currentColor"/>
      </svg>
    </button>
  </div>
  <div class="logo">
    {% if section.settings.logo_image != blank %}
      <img src="{{ section.settings.logo_image | asset_url }}" alt="Company Logo" width="" height="">
    {% else %}
      <span>TISSO VISON</span>
    {% endif %}
  </div>
  <div class="gift-message">
    {% if section.settings.gift_message != blank %}
      <p>{{ section.settings.gift_message }}</p>
    {% else %}
      <p>Find the ideal gift for your loved ones.</p>
    {% endif %}
  </div>
  <div class="gift-cta">
    {% if section.settings.gift_cta_text != blank %}
      <a href="{{ section.settings.gift_cta_link |  default: '#' }}" class="gift-button gift-link">
        {{- section.settings.gift_cta_text -}}
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" class="icon icon-arrow" viewBox="0 0 14 10">
          <path fill="currentColor" fill-rule="evenodd" d="M8.537.808a.5.5 0 0 1 .817-.162l4 4a.5.5 0 0 1 0 .708l-4 4a.5.5 0 1 1-.708-.708L11.793 5.5H1a.5.5 0 0 1 0-1h10.793L8.646 1.354a.5.5 0 0 1-.109-.546" clip-rule="evenodd"/>
        </svg>
      </a>
    {% else %}
      <a href="#" class="gift-button">
        choose gift
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" class="icon icon-arrow" viewBox="0 0 14 10">
          <path fill="currentColor" fill-rule="evenodd" d="M8.537.808a.5.5 0 0 1 .817-.162l4 4a.5.5 0 0 1 0 .708l-4 4a.5.5 0 1 1-.708-.708L11.793 5.5H1a.5.5 0 0 1 0-1h10.793L8.646 1.354a.5.5 0 0 1-.109-.546" clip-rule="evenodd"/>
        </svg>
      </a>
    {% endif %}
  </div>
</section>

<style>
  .custom-header {
    background-color: #f7f7f7;
    padding: 23px 16px;
    display: grid;
    width: 100%;
    grid-template-columns: auto 1fr auto;
    grid-template-areas: 'left center right';
    align-items: center;
  }

  .hamburger-menu {
    grid-area: left;
    justify-self: start;
    width: 24px;
    height: 24px;
  }

  .hamburger-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    border: 0;
    background: transparent;
    cursor: pointer;
    color: #000;
  }

  .logo {
    grid-area: center;
    justify-self: center;
  }

  .logo img {
    object-fit: cover;
    object-position: center;
    width: 100%;
    height: 100%;
    max-height: 44px;
    max-width: 150px;
    display: block;
  }

  .logo span {
    font-family: 'Jost', sans-serif;
    font-weight: 600;
    font-size: 20px;
    line-height: 25.6px;
    letter-spacing: 0px;
    text-align: center;
    text-transform: uppercase;
    color: #000;
  }

  .gift-message {
    display: none;
    grid-area: center;
    justify-self: center;
  }

  .gift-message p {
    font-family: Jost;
    font-weight: 400;
    font-style: Regular;
    font-size: 16px;
    leading-trim: NONE;
    line-height: 13.42px;
    letter-spacing: 0px;
    text-align: center;
    color: #000000;
    margin: 0;
  }

  .gift-cta {
    display: none;
  }

  .gift-cta .gift-button {
    align-items: center;
    justify-content: space-between;
    display: inline-flex;
    gap: 18px;
    border: 0;
    padding: 0px;
    background: transparent;
    cursor: pointer;
    font-family: Jost;
    font-weight: 400;
    font-size: 16px;
    line-height: 20.48px;
    letter-spacing: 0px;
    text-align: center;
  }

  @media screen and (min-width: 720px) {
    .hamburger-menu {
      display: none;
    }
    .custom-header {
      padding: 10px 30px;
    }

    .logo {
      grid-area: left;
      justify-self: start;
    }

    .gift-message {
      display: block;
      text-align: center;
    }

    .gift-cta {
      position: relative;
      display: inline-flex;
      grid-area: right;
      justify-self: end;
      background-color: #fff544;
      color: #000;
      padding: 11px 40px;
      overflow: hidden;
      cursor: pointer;
      transition: color 0.3s ease, background-color 0.3s ease;
    }

    /* sliding black overlay */
    .gift-cta::before {
      content: '';
      position: absolute;
      inset: 0;
      background-color: #000;
      transform: scaleX(0);
      transform-origin: left center;
      transition: transform 0.25s ease-in-out;
      z-index: 0;
      will-change: transform;
    }

    .gift-cta,
    .gift-cta * {
      position: relative;
      color: inherit;
      text-decoration: none;
      text-transform: uppercase;
      z-index: 1;
      transition: color 0.1 ease-in-out;
    }

    .gift-cta:hover,
    .gift-cta:focus {
      background-color: transparent;
      color: #fff;
    }

    .gift-cta .gift-button a {
      color: inherit;
    }

    /* hover/focus transform moved to a hover-capable media query below */

    .gift-cta:focus-visible {
      outline: 2px solid #000;
      outline-offset: 2px;
    }
  }

  /* Respect reduced motion preferences */
  @media (prefers-reduced-motion: reduce) {
    .gift-cta::before,
    .gift-cta * {
      transition: none !important;
    }
    .gift-cta:hover::before,
    .gift-cta:focus::before {
      transform: scaleX(1);
    }
  }

  /* Desktop-only hover (pointer: fine, supports hover) */
  @media (hover: hover) and (pointer: fine) {
    .gift-cta:hover::before,
    .gift-cta:focus::before {
      transform: scaleX(1);
    }
  }

  /* Touch & keyboard fallbacks: instant/snappier overlay */
  .gift-cta:active::before,
  .gift-cta:focus-within::before {
    transform: scaleX(1);
    transition-duration: 0.12s;
  }

  .gift-cta:focus-within {
    outline: 2px solid #000;
    outline-offset: 2px;
  }

  @media screen and (min-width: 1280px) {
    .custom-header {
      padding: 10px 50px;
    }
  }
</style>

{% schema %}
{
  "name": "Custom Header",
  "settings": [
    {
      "type": "header",
      "content": "Custom Header"
    },
    {
      "type": "image_picker",
      "label": "Logo Image",
      "id": "logo_image"
    },
    {
      "type": "text",
      "id": "gift_message",
      "label": "Gift Message",
      "default": "Find the ideal gift for your loved ones."
    },
    {
      "type": "url",
      "id": "gift_cta_link",
      "label": "Gift CTA Link"
    },
    {
      "type": "text",
      "id": "gift_cta_text",
      "label": "Gift CTA Text",
      "default": "choose gift"
    }
  ]
}
{% endschema %}
