<section class="product-grid-section">
  <h2 class="product-grid__title">{{ section.settings.section_title }}</h2>

  <div class="product-grid__container">
    {%- if section.blocks.size > 0 -%}
      {%- for block in section.blocks -%}
        {%- assign product = block.settings.product -%}
        <div class="product-grid__item" {{ block.shopify_attributes }}>
          {%- if product != blank -%}
            <div class="product-grid__image-wrapper">
              <div class="product-grid__image-container">
                <img
                  src="{{ product.featured_image | image_url: width: 433 }}"
                  alt="{{ product.featured_image.alt | escape }}"
                  width="{{ product.featured_image.width }}"
                  height="{{ product.featured_image.height }}"
                  loading="lazy">
              </div>
              <div class="product-grid__popup-trigger" data-target="#popup-{{ block.id }}"></div>
            </div>
          {%- endif -%}
        </div>
      {%- endfor -%}
    {%- else -%}
      <div class="no-products-message">
        <p>No products available</p>
      </div>
    {%- endif -%}
  </div>

  <div>
    {%- for block in section.blocks -%}
      {%- assign product = block.settings.product -%}
      {%- if product != blank -%}
        <section
          class="popup-overlay hidden"
          id="popup-{{ block.id }}"
          data-product-handle="{{ product.handle }}"
          data-bonus-handle="dark-winter-jacket">
          <div class="popup-modal">
            {% render 'product-popup-content'
              , popup_product: product %}
          </div>
        </section>
      {%- endif -%}
    {%- endfor -%}
  </div>
</section>


<style>
  .popup-overlay.hidden {
    display: none;
  }

  * {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  .product-grid-section {
    max-width: 3088px;
    margin: 0 auto;
    padding: 40px 16px 23px;
  }

  .product-grid__title {
    color: #000000;
    font-family: Lustria;
    font-weight: 400;
    font-size: 24px;
    line-height: 120%;
    margin-bottom: 20px;
    text-align: center;
  }

  .product-grid__container {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 4px;
  }

  .product-grid__item {
    width: 100%;
  }

  .product-grid__image-wrapper {
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
  }

  .product-grid__image-container {
    width: 100%;
    height: 100%;
    overflow: hidden;
    position: relative;
    aspect-ratio: 9 / 10;
  }

  .product-grid__image-container img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .product-grid__popup-trigger {
    position: absolute;
    top: 15%;
    right: 20%;
    width: 16px;
    height: 16px;
    background-color: #f8f8f8e5;
    border-radius: 50%;
    cursor: pointer;
    z-index: 2;
    display: flex !important;
    align-items: center;
    justify-content: center;
  }

  /* plus sign styles */
  .product-grid__popup-trigger::before {
    content: '+';
    font-size: 11px;
    color: #000;
  }

  .no-products-message {
    text-align: center;
    font-size: 18px;
    color: #666666;
  }

  /* Popup modal styles */
  .popup-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100vh;
    background-color: rgba(0, 0, 0, 0.5);
    z-index: 1000;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px;
  }

  .popup-modal {
    position: relative;
    background-color: #fff;
    padding: 36px 20px 25px;
    width: 100%;
    height: 100%;
    max-height: 447px;
    max-width: 311px;
  }

  .popup__close-button {
    position: absolute;
    top: 0;
    right: 10px;
    font-size: 24px;
    color: #000;
    cursor: pointer;
    z-index: 1001;
  }

  .popup__content {
    display: grid;
    width: 100%;
    grid-template-columns: auto 1fr;
    gap: 8px;
  }

  .popup__image-container {
    background-color: #666666;
    aspect-ratio: 6 / 7;
    width: 100%;
    max-width: 120px;
    height: auto;
    overflow: hidden;
    position: relative;
  }

  .popup__image-container img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .popup__content-container {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 11px;
    max-width: 146px;
    width: 100%;
  }

  .popup__product-title {
    font-family: Jost;
    font-weight: 300;
    font-size: 16px;
    line-height: 120%;
    color: #000000;
  }

  .popup__product-price {
    font-family: Lustria;
    font-weight: 400;
    font-size: 16px;
    line-height: 120%;
    color: #000000;
  }

  .popup__product-description {
    color: #000;
    font-family: Jost;
    font-size: 12px;
    font-weight: 300;
    line-height: 110%;
    letter-spacing: -0.12px;
  }

  .popup__variants-selectors {
    margin-top: 10px;
    display: grid;
    grid-template-columns: 1fr;
    gap: 11px;
  }

  .popup__color-group {
    display: flex;
    flex-direction: column;
    flex: 1;
    gap: 5px;
  }

  .popup__color-label {
    font-family: Jost;
    font-weight: 400;
    font-size: 14px;
    line-height: 130%;
    color: #000000;
  }

  .popup__color-options {
    position: relative;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    width: 100%;
    border: 1px solid #000000;
  }

  .color-slider {
    display: flex !important;
    position: absolute;
    top: 0;
    left: 0;
    width: 50%;
    height: 100%;
    background: #000;
    z-index: 1;
    transition: transform 0.3s ease;
    pointer-events: none;
    opacity: 0;
  }

  .popup__color-option {
    width: 100%;
    padding: 11px 15px;
    cursor: pointer;
    position: relative;
    z-index: 2;
    transition: color 0.3s ease;
    color: #000;
    font-family: Jost;
    font-size: 18px;
    font-weight: 400;
    line-height: 100%;
    letter-spacing: -0.36px;
    text-transform: capitalize;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .color-indicator-bar {
    display: inline-block;
    border: 1px solid #000000;
    width: 5px;
    height: 100%;
    position: absolute;
    top: 0;
    left: 0;
    border-top: none;
    border-bottom: none;
  }

  .popup__color-option.active {
    color: #fff;
    background-color: #000;
  }

  .popup__size-group {
    display: flex;
    flex-direction: column;
    gap: 5px;
  }

  .popup__size-label {
    font-family: Jost;
    font-weight: 400;
    font-size: 16px;
    line-height: 130%;
    color: #000000;
  }

  .popup__size-trigger-wrapper {
    display: flex;
    align-items: center;
    justify-content: space-between;
    border: 1px solid #000000;
    cursor: pointer;
    width: 100%;
    padding: 0 15px;
    position: relative;
  }

  .popup__size-trigger {
    font-family: Jost;
    font-weight: 400;
    font-size: 16px;
    line-height: 130%;
    color: #000000;
    width: 80%;
    border-right: 1px solid #000000;
    padding: 11px 0;
    box-sizing: border-box;
  }

  .popup__size-trigger.selected {
    text-align: center;
  }

  .popup__size-arrow {
    width: 16px;
    height: 16px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .popup__size-options {
    position: absolute;
    left: -1px;
    top: 100%;
    width: 100%;
    display: flex;
    flex-direction: column;
    background: #fff;
    border: 1px solid #000;
    box-sizing: content-box;
    z-index: 999;
    overflow: hidden;
    max-height: 0;
    opacity: 0;
    transform-origin: top center;
    transform: translateY(-6px);
    transition: max-height 260ms cubic-bezier(0.2, 0.9, 0.2, 1)
    , opacity 200ms ease
    , transform 220ms cubic-bezier(0.2, 0.9, 0.2, 1);
  }

  .popup__size-option {
    width: 100%;
    padding: 6px 12px;
    font-family: Jost;
    font-weight: 400;
    font-size: 14px;
    line-height: 130%;
    color: #000000;
    cursor: pointer;
    text-align: center;
  }

  .popup__size-option:hover {
    background-color: #000;
    color: #fff;
  }

  .rotate-180 {
    transform: rotate(180deg);
    transition: transform 260ms cubic-bezier(0.2, 0.9, 0.2, 1);
  }

  .popup__size-options.is-open {
    max-height: 97px;
    opacity: 1;
    transform: translateY(0);
    overflow-y: auto;
  }

  .popup__cta {
    position: relative;
    background-color: #000000;
    border: none;
    width: 100%;
    height: 100%;
    max-height: 45px;
    margin-top: 50px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .popup__cta a {
    position: absolute;
    text-decoration: none;
    color: #ffffff;
    font-family: Jost;
    font-weight: 400;
    font-size: 16px;
    line-height: 20.48px;
    text-transform: uppercase;
    left: 50%;
    transform: translateX(-50%);
  }

  .popup__cta svg {
    position: absolute;
    right: 10%;
    width: 25px;
    height: 10px;
    color: #ffffff;
    text-align: right;
  }

  /* media queries */
  @media (min-width: 768px) {
    .product-grid__container {
      grid-template-columns: repeat(3, 1fr);
      gap: 24px;
    }
    .product-grid__title {
      text-align: left;
      font-family: Lustria;
      font-weight: 400;
      font-size: 36px;
      line-height: 120%;
      margin-bottom: 30px;
      text-align: left;
    }

    .product-grid__image-container {
      width: 100%;
      height: 100%;
      overflow: hidden;
      position: relative;
      aspect-ratio: 19 / 20;
    }

    .product-grid__popup-trigger {
      position: absolute;
      top: 15%;
      right: 20%;
      width: 24px;
      height: 24px;
      background-color: #f8f8f8e5;
      border-radius: 50%;
      cursor: pointer;
      z-index: 2;
      display: flex !important;
      align-items: center;
      justify-content: center;
    }

    /* plus sign styles */
    .product-grid__popup-trigger::before {
      content: '+';
      font-size: 19px;
      color: #000;
    }
  }

  @media (min-width: 1280px) {
    .product-grid-section {
      padding: 90px 50px;
    }
  }

  @media (min-width: 1920px) {
    .product-grid__title {
      display: none
    }
  }
</style>

{% schema %}
  {
    "name": "Product Grid",
    "settings": [
      {
        "type": "header",
        "content": "Product Grid Settings"
      }, {
        "type": "text",
        "id": "section_title",
        "label": "Section Title",
        "default": "Tisso vison in the wild"
      }
    ],
    "blocks": [
      {
        "type": "product",
        "name": "Product",
        "settings": [
          {
            "type": "product",
            "id": "product",
            "label": "Choose Product"
          }
        ],
        "limit": 6
      }
    ],
    "presets": [
      {
        "name": "Product Grid"
      }
    ]
  }
{% endschema %}