<section class="product-grid-section">
  <h2 class="product-grid__title">{{ section.settings.section_title }}</h2>

  <div class="product-grid__container">
    {% if section.blocks.size > 0 %}
      {% for block in section.blocks %}
        <div class="product-grid__item" {{ block.shopify_attributes }}>
          {%- assign product = block.settings.product -%}
          {% if product != blank %}
            <div class="product-grid__image-wrapper">
              <div class="product-grid__image-container">
                <img
                  src="{{ product | image_url: 433 }}"
                  alt="{{ product.alt | escape }}"
                  width="{{ product.width }}"
                  height="{{ product.height }}"
                  loading="lazy"
                >
              </div>
              <div class="product-grid__popup-trigger"></div>
            </div>
          {% endif %}
        </div>
      {% endfor %}
    {% else %}
      <div class="no-products-message">
        <p>No products available</p>
      </div>
    {% endif %}
  </div>
</section>

{% comment %}
  <div class="product-grid__item">

  </div>
{% endcomment %}
<style>
  * {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  .product-grid-section {
    max-width: 1440px; // Need to come back to this
    margin: 0 auto;
    padding: 40px 16px;
  }

  .product-grid__title {
    color: #000000;
    font-family: Lustria;
    font-weight: 400;
    font-size: 24px;
    line-height: 120%;
    margin-bottom: 20px;
    text-align: center; // destop = left
  }

  .product-grid__container {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 16px;
  }

  .product-grid__item {
    width: 100%;
  }

  .product-grid__image-wrapper {
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
  }

  .product-grid__image-container {
    width: 100%;
    height: 100%;
    overflow: hidden;
    position: relative;
    aspect-ratio: 9 / 10;
  }

  .product-grid__image-container img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .product-grid__popup-trigger {
    position: absolute;
    top: 15%;
    right: 20%;
    width: 24px;
    height: 24px;
    background-color: #f8f8f8e5;
    border-radius: 50%;
    cursor: pointer;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .no-products-message {
    text-align: center;
    font-size: 18px;
    color: #666666;
  }
</style>

{% schema %}
{
  "name": "Product Grid",
  "settings": [
    {
      "type": "header",
      "content": "Product Grid Settings"
    },
    {
      "type": "text",
      "id": "section_title",
      "label": "Section Title",
      "default": "Tisso vison in the wild"
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "settings": [
        {
          "type": "image_picker",
          "id": "product",
          "label": "Choose Product Image"
        }
      ],
      "limit": 6
    }
  ],
  "presets": [
    {
      "name": "Product Grid"
    }
  ]
}
{% endschema %}
