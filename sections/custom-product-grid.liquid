<section class="product-grid-section">
  <h2 class="product-grid__title">{{ section.settings.section_title }}</h2>

  <div class="product-grid__container">
    {% if section.blocks.size > 0 %}
      {% for block in section.blocks %}
        <div class="product-grid__item" {{ block.shopify_attributes }}>
          {%- assign product = block.settings.product -%}
          {% if product != blank %}
            <div class="product-grid__image-wrapper">
              <div class="product-grid__image-container">
                <img
                  src="{{ product.featured_image | image_url: width: 433 }}"
                  alt="{{ product.featured_image.alt | escape }}"
                  width="{{ product.featured_image.width }}"
                  height="{{ product.featured_image.height }}"
                  loading="lazy"
                >
              </div>
              <div class="product-grid__popup-trigger"></div>
            </div>
          {% endif %}
        </div>
      {% endfor %}
    {% else %}
      <div class="no-products-message">
        <p>No products available</p>
      </div>
    {% endif %}
  </div>
</section>

<style>
  * {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  .product-grid-section {
    max-width: 1440px; // Need to come back to this
    margin: 0 auto;
    padding: 40px 16px;
  }

  .product-grid__title {
    color: #000000;
    font-family: Lustria;
    font-weight: 400;
    font-size: 24px;
    line-height: 120%;
    margin-bottom: 20px;
    text-align: center;
  }

  .product-grid__container {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 16px;
  }

  .product-grid__item {
    width: 100%;
  }

  .product-grid__image-wrapper {
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
  }

  .product-grid__image-container {
    width: 100%;
    height: 100%;
    overflow: hidden;
    position: relative;
    aspect-ratio: 9 / 10;
  }

  .product-grid__image-container img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .product-grid__popup-trigger {
    position: absolute;
    top: 15%;
    right: 20%;
    width: 16px;
    height: 16px;
    background-color: #f8f8f8e5;
    border-radius: 50%;
    cursor: pointer;
    z-index: 2;
    display: flex !important;
    align-items: center;
    justify-content: center;
  }

  /* plus sign styles */
  .product-grid__popup-trigger::before {
    content: '+';
    font-size: 11px;
    color: #000;
  }

  .no-products-message {
    text-align: center;
    font-size: 18px;
    color: #666666;
  }

  /* media queries */
  @media (min-width: 768px) {
    .product-grid__container {
      grid-template-columns: repeat(3, 1fr);
      gap: 24px;
    }
    .product-grid__title {
      text-align: left;
      font-family: Lustria;
      font-weight: 400;
      font-size: 36px;
      line-height: 120%;
      margin-bottom: 30px;
      text-align: left;
    }

    .product-grid__image-container {
      width: 100%;
      height: 100%;
      overflow: hidden;
      position: relative;
      aspect-ratio: 19 / 20;
      max-width: 433px;
    }

    .product-grid__popup-trigger {
      position: absolute;
      top: 15%;
      right: 20%;
      width: 24px;
      height: 24px;
      background-color: #f8f8f8e5;
      border-radius: 50%;
      cursor: pointer;
      z-index: 2;
      display: flex !important;
      align-items: center;
      justify-content: center;
    }

    /* plus sign styles */
    .product-grid__popup-trigger::before {
      content: '+';
      font-size: 19px;
      color: #000;
    }
  }
</style>

{% schema %}
{
  "name": "Product Grid",
  "settings": [
    {
      "type": "header",
      "content": "Product Grid Settings"
    },
    {
      "type": "text",
      "id": "section_title",
      "label": "Section Title",
      "default": "Tisso vison in the wild"
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Choose Product"
        }
      ],
      "limit": 6
    }
  ],
  "presets": [
    {
      "name": "Product Grid"
    }
  ]
}
{% endschema %}
